#!/bin/bash
# agent_setup.sh - Run on every new Linux agent

# Install all required 32-bit packages
sudo dnf install -y \
    libatomic \
    libatomic.i686 \
    libgcc.i686 \
    glibc.i686 \
    glibc-devel.i686 \
    lz4-libs.i686 \
    libstdc++.i686 \
    openssl-devel.i686 \
    libxcrypt-devel.i686 \
    zlib-devel.i686

# Verify critical libraries
echo "=== Verifying libatomic ==="
rpm -qa | grep -i atomic
ls -la /usr/lib/libatomic*

echo "=== Verifying BuildTools ==="
ls /usr/Jenkins/workspace/BuildTools/

echo "=== Setup Complete ==="
