schedules:
- cron: "0 */6 * * *"   # Every 6 hours
  displayName: Update Epic Bug Impact
  branches:
    include:
    - main
  always: true

pool:
  vmImage: 'ubuntu-latest'

steps:
- task: PowerShell@2
  inputs:
    targetType: 'inline'
    script: |
      # Variables
      $org      = "https://dev.azure.com/YOUR_ORG"
      $project  = "YOUR_PROJECT"
      $token    = "$(System.AccessToken)"   # Built-in, no PAT needed
      $headers  = @{ Authorization = "Bearer $token"
                     "Content-Type" = "application/json" }

      # Step 1 — Get all Epics
      $wiql = @{ query = "SELECT [System.Id] FROM WorkItems 
                          WHERE [System.WorkItemType] = 'Epic' 
                          AND [System.TeamProject] = '$project'" } | ConvertTo-Json

      $epics = Invoke-RestMethod `
        -Uri "$org/$project/_apis/wit/wiql?api-version=7.0" `
        -Method POST -Headers $headers -Body $wiql

      foreach ($epic in $epics.workItems) {
          $epicId = $epic.id

          # Step 2 — Get linked Bug count
          $relations = Invoke-RestMethod `
            -Uri "$org/$project/_apis/wit/workitems/$($epicId)?`$expand=relations&api-version=7.0" `
            -Headers $headers

          $bugCount = ($relations.relations | Where-Object {
              $_.rel -eq "System.LinkTypes.Hierarchy-Forward" -or 
              $_.rel -eq "System.LinkTypes.Related"
          }).Count

          # Step 3 — Determine value
          $changeValue = if ($bugCount -ge 15) { "High" }
                         elseif ($bugCount -ge 10) { "Medium" }
                         elseif ($bugCount -ge 5)  { "Low" }
                         else                       { "Low" }

          # Step 4 — PATCH the Epic
          $patch = @(@{ op="add"; path="/fields/Custom.Changes"; value=$changeValue }) | ConvertTo-Json
          Invoke-RestMethod `
            -Uri "$org/$project/_apis/wit/workitems/$($epicId)?api-version=7.0" `
            -Method PATCH -Headers $headers -Body $patch `
            -ContentType "application/json-patch+json"

          Write-Host "Epic $epicId → $changeValue ($bugCount bugs)"
      }
