trigger: none

pool:
  name: 'xx'

steps:
- task: PowerShell@2
  displayName: 'Fetch OKRs and linked count'
  inputs:
    targetType: 'inline'
    pwsh: false
    script: |
      $ErrorActionPreference = "Stop"

      # Variables
      $org     = "org"
      $project = "project"
      $token   = "$(System.AccessToken)"

      if (:IsNullOrWhiteSpace($token)) {
        Write-Host "System.AccessToken is EMPTY. Enable 'Allow scripts to access the OAuth token'."
        exit 1
      }

      $headers = @{
        Authorization  = "Bearer $token"
        "Content-Type" = "application/json"
      }

      # Step 1 — Get all OKR IDs using WIQL
      $wiqlObj = @{
        query = @"
      SELECT [System.Id]
      FROM WorkItems
      WHERE [System.WorkItemType] = 'OKR'
        AND [System.TeamProject] = '$project'
      "@
      }

      $wiql = $wiqlObj | ConvertTo-Json -Depth 5

      Write-Host "Querying OKRs..."
      $okrsResponse = Invoke-RestMethod `
        -Uri "$org/$project/_apis/wit/wiql?api-version=6.1-preview" `
        -Method POST `
        -Headers $headers `
        -Body $wiql

      if (-not $okrsResponse.workItems) {
        Write-Host "No OKR work items returned by WIQL."
        exit 0
      }

      Write-Host "Found $($okrsResponse.workItems.Count) OKR(s)."

      foreach ($okrRef in $okrsResponse.workItems) {
        $okrId = [int]$okrRef.id  # force numeric
        Write-Host "----------------------------------------"
        Write-Host "OKR ID: $okrId"

        # Build URL safely (prevents '&amp;' and guarantees the ID is in the path)
        $base = "$org/$project/_apis/wit/workitems/$okrId"
        $ub = [System.UriBuilder]::new($base)
        $ub.Query = "`$expand=relations&api-version=6.1-preview"
        $uri = $ub.Uri.AbsoluteUri

        Write-Host "GET $uri"

        $okrDetails = Invoke-RestMethod `
          -Uri $uri `
          -Method GET `
          -Headers $headers

        $relations = $okrDetails.relations
        if (-not $relations) {
          Write-Host "Linked items: 0"
          continue
        }

        $linkedCount = ($relations | Where-Object {
          $_.rel -eq "System.LinkTypes.Hierarchy-Forward" -or
          $_.rel -eq "System.LinkTypes.Related"
        }).Count

        Write-Host "Linked items (Hierarchy-Forward/Related): $linkedCount"
      }
